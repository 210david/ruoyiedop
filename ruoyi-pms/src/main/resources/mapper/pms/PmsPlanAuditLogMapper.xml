<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.pms.mapper.PmsPlanAuditLogMapper">

    <resultMap type="PmsPlanAuditLog" id="PmsPlanAuditLogResult">
        <result property="logId"        column="log_id"/>
        <result property="planId"       column="plan_id"/>
        <result property="auditAction"  column="audit_action"/>
        <result property="auditBy"      column="audit_by"/>
        <result property="auditTime"    column="audit_time"/>
        <result property="auditRemark"  column="audit_remark"/>
    </resultMap>

    <select id="selectAuditLogByPlanId" parameterType="Long" resultMap="PmsPlanAuditLogResult">
        SELECT log_id, plan_id, audit_action, audit_by, audit_time, audit_remark
        FROM pms_plan_audit_log
        WHERE plan_id = #{planId}
        ORDER BY log_id ASC
    </select>

    <insert id="insertAuditLog" parameterType="PmsPlanAuditLog" useGeneratedKeys="true" keyProperty="logId">
        INSERT INTO pms_plan_audit_log (plan_id, audit_action, audit_by, audit_time, audit_remark)
        VALUES (#{planId}, #{auditAction}, #{auditBy}, sysdate(), #{auditRemark})
    </insert>

</mapper>
