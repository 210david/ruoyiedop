<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.pms.mapper.PmsContractAuditLogMapper">

    <resultMap type="PmsContractAuditLog" id="PmsContractAuditLogResult">
        <result property="logId"        column="log_id"/>
        <result property="contractId"   column="contract_id"/>
        <result property="auditAction"  column="audit_action"/>
        <result property="auditBy"      column="audit_by"/>
        <result property="auditTime"    column="audit_time"/>
        <result property="auditRemark"  column="audit_remark"/>
    </resultMap>

    <select id="selectAuditLogByContractId" parameterType="Long" resultMap="PmsContractAuditLogResult">
        SELECT log_id, contract_id, audit_action, audit_by, audit_time, audit_remark
        FROM pms_contract_audit_log
        WHERE contract_id = #{contractId}
        ORDER BY log_id ASC
    </select>

    <insert id="insertAuditLog" parameterType="PmsContractAuditLog" useGeneratedKeys="true" keyProperty="logId">
        INSERT INTO pms_contract_audit_log (contract_id, audit_action, audit_by, audit_time, audit_remark)
        VALUES (#{contractId}, #{auditAction}, #{auditBy}, sysdate(), #{auditRemark})
    </insert>

</mapper>
