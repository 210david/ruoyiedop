<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.pms.mapper.PmsInvoiceAuditLogMapper">

    <resultMap type="PmsInvoiceAuditLog" id="PmsInvoiceAuditLogResult">
        <result property="logId"        column="log_id"/>
        <result property="invoiceId"   column="invoice_id"/>
        <result property="auditAction" column="audit_action"/>
        <result property="auditBy"     column="audit_by"/>
        <result property="auditTime"   column="audit_time"/>
        <result property="auditRemark" column="audit_remark"/>
    </resultMap>

    <select id="selectAuditLogByInvoiceId" parameterType="Long" resultMap="PmsInvoiceAuditLogResult">
        SELECT log_id, invoice_id, audit_action, audit_by, audit_time, audit_remark
        FROM pms_invoice_audit_log
        WHERE invoice_id = #{invoiceId}
        ORDER BY log_id ASC
    </select>

    <insert id="insertAuditLog" parameterType="PmsInvoiceAuditLog" useGeneratedKeys="true" keyProperty="logId">
        INSERT INTO pms_invoice_audit_log (invoice_id, audit_action, audit_by, audit_time, audit_remark)
        VALUES (#{invoiceId}, #{auditAction}, #{auditBy}, sysdate(), #{auditRemark})
    </insert>

</mapper>
