<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.pms.mapper.PmsOrderAuditLogMapper">

    <resultMap type="PmsOrderAuditLog" id="PmsOrderAuditLogResult">
        <result property="logId"        column="log_id"/>
        <result property="orderId"     column="order_id"/>
        <result property="auditAction" column="audit_action"/>
        <result property="auditBy"     column="audit_by"/>
        <result property="auditTime"   column="audit_time"/>
        <result property="auditRemark" column="audit_remark"/>
    </resultMap>

    <select id="selectAuditLogByOrderId" parameterType="Long" resultMap="PmsOrderAuditLogResult">
        SELECT log_id, order_id, audit_action, audit_by, audit_time, audit_remark
        FROM pms_order_audit_log
        WHERE order_id = #{orderId}
        ORDER BY log_id ASC
    </select>

    <insert id="insertAuditLog" parameterType="PmsOrderAuditLog" useGeneratedKeys="true" keyProperty="logId">
        INSERT INTO pms_order_audit_log (order_id, audit_action, audit_by, audit_time, audit_remark)
        VALUES (#{orderId}, #{auditAction}, #{auditBy}, sysdate(), #{auditRemark})
    </insert>

</mapper>
