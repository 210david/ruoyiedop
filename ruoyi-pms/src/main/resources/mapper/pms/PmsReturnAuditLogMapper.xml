<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.pms.mapper.PmsReturnAuditLogMapper">

    <resultMap type="PmsReturnAuditLog" id="PmsReturnAuditLogResult">
        <result property="logId"        column="log_id"/>
        <result property="returnId"    column="return_id"/>
        <result property="auditAction" column="audit_action"/>
        <result property="auditBy"     column="audit_by"/>
        <result property="auditTime"   column="audit_time"/>
        <result property="auditRemark" column="audit_remark"/>
    </resultMap>

    <select id="selectAuditLogByReturnId" parameterType="Long" resultMap="PmsReturnAuditLogResult">
        SELECT log_id, return_id, audit_action, audit_by, audit_time, audit_remark
        FROM pms_return_audit_log
        WHERE return_id = #{returnId}
        ORDER BY log_id ASC
    </select>

    <insert id="insertAuditLog" parameterType="PmsReturnAuditLog" useGeneratedKeys="true" keyProperty="logId">
        INSERT INTO pms_return_audit_log (return_id, audit_action, audit_by, audit_time, audit_remark)
        VALUES (#{returnId}, #{auditAction}, #{auditBy}, sysdate(), #{auditRemark})
    </insert>

</mapper>
