<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.safety.mapper.SafetyExamCategoryMapper">

    <resultMap type="SafetyExamCategory" id="SafetyExamCategoryResult">
        <result property="categoryId"    column="category_id"/>
        <result property="parentId"      column="parent_id"/>
        <result property="categoryName"  column="category_name"/>
        <result property="orderNum"      column="order_num"/>
        <result property="enterpriseId"  column="enterprise_id"/>
        <result property="status"        column="status"/>
        <result property="delFlag"       column="del_flag"/>
        <result property="createBy"      column="create_by"/>
        <result property="createTime"    column="create_time"/>
        <result property="updateBy"      column="update_by"/>
        <result property="updateTime"    column="update_time"/>
        <result property="remark"        column="remark"/>
    </resultMap>

    <sql id="selectSafetyExamCategoryVo">
        select category_id, parent_id, category_name, order_num, enterprise_id, status, del_flag,
               create_by, create_time, update_by, update_time, remark
        from biz_safety_exam_category
    </sql>

    <select id="selectSafetyExamCategoryList" parameterType="SafetyExamCategory" resultMap="SafetyExamCategoryResult">
        <include refid="selectSafetyExamCategoryVo"/>
        <where>
            del_flag = '0'
            <if test="parentId != null"> AND parent_id = #{parentId}</if>
            <if test="categoryName != null and categoryName != ''"> AND category_name like concat('%', #{categoryName}, '%')</if>
            <if test="status != null and status != ''"> AND status = #{status}</if>
            <if test="enterpriseId != null"> AND enterprise_id = #{enterpriseId}</if>
        </where>
        order by order_num, category_id
    </select>

    <select id="selectSafetyExamCategoryById" parameterType="Long" resultMap="SafetyExamCategoryResult">
        <include refid="selectSafetyExamCategoryVo"/>
        where category_id = #{categoryId} and del_flag = '0'
    </select>

    <insert id="insertSafetyExamCategory" parameterType="SafetyExamCategory" useGeneratedKeys="true" keyProperty="categoryId">
        insert into biz_safety_exam_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="parentId != null">parent_id,</if>
            <if test="categoryName != null and categoryName != ''">category_name,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="enterpriseId != null">enterprise_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="parentId != null">#{parentId},</if>
            <if test="categoryName != null and categoryName != ''">#{categoryName},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="enterpriseId != null">#{enterpriseId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSafetyExamCategory" parameterType="SafetyExamCategory">
        update biz_safety_exam_category
        <trim prefix="SET" suffixOverrides=",">
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="enterpriseId != null">enterprise_id = #{enterpriseId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where category_id = #{categoryId}
    </update>

    <update id="deleteSafetyExamCategoryById" parameterType="Long">
        update biz_safety_exam_category set del_flag = '2' where category_id = #{categoryId}
    </update>

    <update id="deleteSafetyExamCategoryByIds" parameterType="String">
        update biz_safety_exam_category set del_flag = '2' where category_id in
        <foreach item="categoryId" collection="array" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </update>

</mapper>
