<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.pdm.mapper.PdmChangeAuditLogMapper">

    <resultMap type="PdmChangeAuditLog" id="PdmChangeAuditLogResult">
        <result property="logId"       column="log_id"/>
        <result property="changeId"    column="change_id"/>
        <result property="auditAction" column="audit_action"/>
        <result property="auditBy"     column="audit_by"/>
        <result property="auditTime"   column="audit_time"/>
        <result property="auditRemark" column="audit_remark"/>
    </resultMap>

    <sql id="selectAuditLogVo">
        select log_id, change_id, audit_action, audit_by, audit_time, audit_remark from pdm_change_audit_log
    </sql>

    <select id="selectAuditLogByChangeId" parameterType="Long" resultMap="PdmChangeAuditLogResult">
        <include refid="selectAuditLogVo"/>
        where change_id = #{changeId}
        order by log_id asc
    </select>

    <insert id="insertAuditLog" parameterType="PdmChangeAuditLog" useGeneratedKeys="true" keyProperty="logId">
        insert into pdm_change_audit_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="changeId != null">change_id,</if>
            <if test="auditAction != null">audit_action,</if>
            <if test="auditBy != null">audit_by,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="auditRemark != null">audit_remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="changeId != null">#{changeId},</if>
            <if test="auditAction != null">#{auditAction},</if>
            <if test="auditBy != null">#{auditBy},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="auditRemark != null">#{auditRemark},</if>
        </trim>
    </insert>

</mapper>
