<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.fin.mapper.FinApWriteoffMapper">

    <resultMap id="FinApWriteoffResult" type="com.ruoyi.fin.domain.FinApWriteoff">
        <result property="writeoffId"     column="writeoff_id"/>
        <result property="apId"           column="ap_id"/>
        <result property="paymentId"      column="payment_id"/>
        <result property="writeoffAmount" column="writeoff_amount"/>
        <result property="writeoffDate"   column="writeoff_date"/>
        <result property="period"         column="period"/>
        <result property="deptId"         column="dept_id"/>
        <result property="userId"         column="user_id"/>
        <result property="createBy"       column="create_by"/>
        <result property="createTime"     column="create_time"/>
        <result property="remark"         column="remark"/>
    </resultMap>

    <insert id="insertWriteoff" parameterType="com.ruoyi.fin.domain.FinApWriteoff"
            useGeneratedKeys="true" keyProperty="writeoffId">
        INSERT INTO fin_ap_writeoff (
            ap_id, payment_id, writeoff_amount, writeoff_date, period,
            dept_id, user_id, create_by, create_time, remark
        ) VALUES (
            #{apId}, #{paymentId}, #{writeoffAmount}, #{writeoffDate}, #{period},
            #{deptId}, #{userId}, #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <select id="selectByApId" parameterType="java.lang.Long" resultMap="FinApWriteoffResult">
        SELECT writeoff_id, ap_id, payment_id, writeoff_amount, writeoff_date, period,
               dept_id, user_id, create_by, create_time, remark
        FROM fin_ap_writeoff
        WHERE ap_id = #{apId} AND del_flag = '0'
        ORDER BY writeoff_id
    </select>

    <select id="sumWriteoffAmount" parameterType="java.lang.Long" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(writeoff_amount), 0)
        FROM fin_ap_writeoff
        WHERE ap_id = #{apId} AND del_flag = '0'
    </select>

</mapper>