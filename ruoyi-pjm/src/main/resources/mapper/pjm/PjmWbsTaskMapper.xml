<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.pjm.mapper.PjmWbsTaskMapper">

    <resultMap type="com.ruoyi.pjm.domain.PjmWbsTask" id="PjmWbsTaskResult">
        <id     property="taskId"            column="task_id"/>
        <result property="projectId"         column="project_id"/>
        <result property="parentTaskId"      column="parent_task_id"/>
        <result property="taskCode"          column="task_code"/>
        <result property="taskName"          column="task_name"/>
        <result property="taskType"          column="task_type"/>
        <result property="status"            column="status"/>
        <result property="priority"          column="priority"/>
        <result property="progress"          column="progress"/>
        <result property="needPurchase"      column="need_purchase"/>
        <result property="purchaseRequestId" column="purchase_request_id"/>
        <result property="ownerId"           column="owner_id"/>
        <result property="ownerName"         column="owner_name"/>
        <result property="planStartDate"     column="plan_start_date"/>
        <result property="planEndDate"       column="plan_end_date"/>
        <result property="actualStartDate"   column="actual_start_date"/>
        <result property="actualEndDate"     column="actual_end_date"/>
        <result property="planHours"         column="plan_hours"/>
        <result property="actualHours"       column="actual_hours"/>
        <result property="description"       column="description"/>
        <result property="delFlag"           column="del_flag"/>
        <result property="createBy"          column="create_by"/>
        <result property="createTime"        column="create_time"/>
        <result property="updateBy"          column="update_by"/>
        <result property="updateTime"        column="update_time"/>
        <result property="remark"            column="remark"/>
    </resultMap>

    <sql id="selectTaskVo">
        select task_id, project_id, parent_task_id, task_code, task_name, task_type,
               status, priority, progress, need_purchase, purchase_request_id,
               owner_id, owner_name, plan_start_date, plan_end_date,
               actual_start_date, actual_end_date, plan_hours, actual_hours,
               description, del_flag, create_by, create_time, update_by, update_time, remark
        from pjm_wbs_task
    </sql>

    <select id="selectTaskList" parameterType="com.ruoyi.pjm.domain.PjmWbsTask"
            resultMap="PjmWbsTaskResult">
        <include refid="selectTaskVo"/>
        <where>
            <if test="projectId != null">AND project_id = #{projectId}</if>
            <if test="taskName != null and taskName != ''">AND task_name like concat('%', #{taskName}, '%')</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            <if test="taskType != null and taskType != ''">AND task_type = #{taskType}</if>
            AND del_flag = '0'
        </where>
        order by parent_task_id, task_code, create_time
    </select>

    <select id="selectTaskById" parameterType="Long" resultMap="PjmWbsTaskResult">
        <include refid="selectTaskVo"/>
        where task_id = #{taskId}
    </select>

    <insert id="insertTask" parameterType="com.ruoyi.pjm.domain.PjmWbsTask"
            useGeneratedKeys="true" keyProperty="taskId">
        insert into pjm_wbs_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectId != null">project_id,</if>
            <if test="parentTaskId != null">parent_task_id,</if>
            <if test="taskCode != null">task_code,</if>
            <if test="taskName != null">task_name,</if>
            <if test="taskType != null">task_type,</if>
            <if test="status != null">status,</if>
            <if test="priority != null">priority,</if>
            <if test="progress != null">progress,</if>
            <if test="needPurchase != null">need_purchase,</if>
            <if test="ownerId != null">owner_id,</if>
            <if test="ownerName != null">owner_name,</if>
            <if test="planStartDate != null">plan_start_date,</if>
            <if test="planEndDate != null">plan_end_date,</if>
            <if test="actualStartDate != null">actual_start_date,</if>
            <if test="actualEndDate != null">actual_end_date,</if>
            <if test="planHours != null">plan_hours,</if>
            <if test="actualHours != null">actual_hours,</if>
            <if test="description != null">description,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectId != null">#{projectId},</if>
            <if test="parentTaskId != null">#{parentTaskId},</if>
            <if test="taskCode != null">#{taskCode},</if>
            <if test="taskName != null">#{taskName},</if>
            <if test="taskType != null">#{taskType},</if>
            <if test="status != null">#{status},</if>
            <if test="priority != null">#{priority},</if>
            <if test="progress != null">#{progress},</if>
            <if test="needPurchase != null">#{needPurchase},</if>
            <if test="ownerId != null">#{ownerId},</if>
            <if test="ownerName != null">#{ownerName},</if>
            <if test="planStartDate != null">#{planStartDate},</if>
            <if test="planEndDate != null">#{planEndDate},</if>
            <if test="actualStartDate != null">#{actualStartDate},</if>
            <if test="actualEndDate != null">#{actualEndDate},</if>
            <if test="planHours != null">#{planHours},</if>
            <if test="actualHours != null">#{actualHours},</if>
            <if test="description != null">#{description},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateTask" parameterType="com.ruoyi.pjm.domain.PjmWbsTask">
        update pjm_wbs_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="parentTaskId != null">parent_task_id = #{parentTaskId},</if>
            <if test="taskCode != null">task_code = #{taskCode},</if>
            <if test="taskName != null">task_name = #{taskName},</if>
            <if test="taskType != null">task_type = #{taskType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="progress != null">progress = #{progress},</if>
            <if test="needPurchase != null">need_purchase = #{needPurchase},</if>
            <if test="purchaseRequestId != null">purchase_request_id = #{purchaseRequestId},</if>
            <if test="ownerId != null">owner_id = #{ownerId},</if>
            <if test="ownerName != null">owner_name = #{ownerName},</if>
            <if test="planStartDate != null">plan_start_date = #{planStartDate},</if>
            <if test="planEndDate != null">plan_end_date = #{planEndDate},</if>
            <if test="actualStartDate != null">actual_start_date = #{actualStartDate},</if>
            <if test="actualEndDate != null">actual_end_date = #{actualEndDate},</if>
            <if test="planHours != null">plan_hours = #{planHours},</if>
            <if test="actualHours != null">actual_hours = #{actualHours},</if>
            <if test="description != null">description = #{description},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where task_id = #{taskId}
    </update>

    <delete id="deleteTaskById" parameterType="Long">
        update pjm_wbs_task set del_flag = '2' where task_id = #{taskId}
    </delete>

    <delete id="deleteTaskByIds" parameterType="String">
        update pjm_wbs_task set del_flag = '2' where task_id in
        <foreach collection="array" item="taskId" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </delete>

    <!-- 递归软删子任务 -->
    <delete id="deleteChildTasks" parameterType="Long">
        update pjm_wbs_task set del_flag = '2'
        where parent_task_id = #{parentTaskId}
           or parent_task_id in (
               select task_id from (
                   select task_id from pjm_wbs_task where parent_task_id = #{parentTaskId}
               ) tmp
           )
    </delete>

    <delete id="deleteByProjectId" parameterType="Long">
        delete from pjm_wbs_task where project_id = #{projectId}
    </delete>

</mapper>
