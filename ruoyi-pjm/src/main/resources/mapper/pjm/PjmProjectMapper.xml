    <sql id="selectProjectVo">
        select project_id, project_no, project_name, project_type, engineering_category, priority, status, progress,
               budget_amount, planned_purchase, actual_purchase, received_amount,
               invoice_amount, paid_amount, purchase_count,
               start_date, end_date, actual_start_date, actual_end_date,
               manager_id, manager_name, dept_id, dept_name, customer,
               owner_unit, build_unit, supervisor_unit, design_unit,
               project_address, build_scale, contract_duration, commence_date, completion_date, quality_standard, contract_amount,
               description, scope, deliverables,
               audit_by, audit_time, audit_opinion,
               del_flag, create_by, create_time, update_by, update_time, remark
        from pjm_project
    </sql>

    <select id="selectProjectList" parameterType="com.ruoyi.pjm.domain.PjmProject"
            resultMap="PjmProjectResult">
        <include refid="selectProjectVo"/>
        <where>
            <if test="projectNo != null and projectNo != ''">
                AND project_no like concat('%', #{projectNo}, '%')
            </if>
            <if test="projectName != null and projectName != ''">
                AND project_name like concat('%', #{projectName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="projectType != null and projectType != ''">
                AND project_type = #{projectType}
            </if>
            <if test="engineeringCategory != null and engineeringCategory != ''">
                AND engineering_category = #{engineeringCategory}
            </if>
            <if test="priority != null and priority != ''">
                AND priority = #{priority}
            </if>
            <if test="managerName != null and managerName != ''">
                AND manager_name like concat('%', #{managerName}, '%')
            </if>
            <if test="managerId != null">
                AND manager_id = #{managerId}
            </if>
            <if test="deptId != null">
                AND dept_id = #{deptId}
            </if>
            <if test="params.beginStartDate != null and params.beginStartDate != ''">
                AND start_date &gt;= #{params.beginStartDate}
            </if>
            <if test="params.endStartDate != null and params.endStartDate != ''">
                AND start_date &lt;= #{params.endStartDate}
            </if>
            AND del_flag = '0'
            <if test="params.dataScope != null and params.dataScope != ''">${params.dataScope}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectProjectById" parameterType="Long" resultMap="PjmProjectResult">
        <include refid="selectProjectVo"/>
        where project_id = #{projectId}
    </select>

