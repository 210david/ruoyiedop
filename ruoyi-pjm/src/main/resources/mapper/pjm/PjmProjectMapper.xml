    <delete id="deleteProjectById" parameterType="Long">
        update pjm_project set del_flag = '2' where project_id = #{projectId}
    </delete>

    <delete id="deleteProjectByIds" parameterType="String">
        update pjm_project set del_flag = '2' where project_id in
        <foreach collection="array" item="projectId" open="(" separator="," close=")">
            #{projectId}
        </foreach>
    </delete>

    <!-- ★ 刷新项目采购汇总（来自 PMS 聚合） -->
    <update id="refreshPurchaseSummary" parameterType="Long">
        update pjm_project pj
        set
            pj.planned_purchase = COALESCE((
                select sum(req.total_amount) from pms_purchase_request req
                where req.source_project_id = pj.project_id and req.del_flag = '0'
            ), 0),
            pj.actual_purchase = COALESCE((
                select sum(ord.total_amount) from pms_purchase_order ord
                where ord.source_project_id = pj.project_id and ord.del_flag = '0'
            ), 0),
            pj.invoice_amount = COALESCE((
                select sum(iv.invoice_amount) from pms_invoice iv
                join pms_purchase_order ord on ord.order_id = iv.order_id
                where ord.source_project_id = pj.project_id
                  and iv.del_flag = '0' and ord.del_flag = '0'
            ), 0),
            pj.paid_amount = COALESCE((
                select sum(ip.payment_amount) from pms_invoice_payment ip
                join pms_invoice iv on iv.invoice_id = ip.invoice_id
                join pms_purchase_order ord on ord.order_id = iv.order_id
                where ord.source_project_id = pj.project_id
                  and ip.del_flag = '0' and iv.del_flag = '0' and ord.del_flag = '0'
            ), 0),
            pj.purchase_count = (
                select count(*) from pms_purchase_request req
                where req.source_project_id = pj.project_id and req.del_flag = '0'
            )
        where pj.project_id = #{projectId}
    </update>

    <!-- ★ 刷新项目进度（WBS 任务平均进度） -->
    <update id="refreshProgress" parameterType="Long">
        update pjm_project pj
        set pj.progress = COALESCE((
            select round(avg(t.progress), 2) from pjm_wbs_task t
            where t.project_id = pj.project_id and t.del_flag = '0'
        ), 0)
        where pj.project_id = #{projectId}
    </update>

