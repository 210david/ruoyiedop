<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.pjm.mapper.PjmInvoiceMapper">

    <resultMap type="com.ruoyi.pjm.domain.PjmInvoice" id="PjmInvoiceResult">
        <id     property="invoiceId"   column="invoice_id"/>
        <result property="invoiceNo"   column="invoice_no"/>
        <result property="projectId"   column="project_id"/>
        <result property="paymentId"   column="payment_id"/>
        <result property="invoiceType" column="invoice_type"/>
        <result property="invoiceStatus" column="invoice_status"/>
        <result property="invoiceAmount" column="invoice_amount"/>
        <result property="taxRate"     column="tax_rate"/>
        <result property="taxAmount"   column="tax_amount"/>
        <result property="invoiceTitle" column="invoice_title"/>
        <result property="taxNo"       column="tax_no"/>
        <result property="invoiceDate" column="invoice_date"/>
        <result property="invoiceAttachment" column="invoice_attachment"/>
        <result property="delFlag"     column="del_flag"/>
        <result property="createBy"    column="create_by"/>
        <result property="createTime"  column="create_time"/>
        <result property="updateBy"    column="update_by"/>
        <result property="updateTime"  column="update_time"/>
        <result property="remark"      column="remark"/>
        <result property="projectName" column="project_name"/>
        <result property="projectNo"   column="project_no"/>
        <result property="paymentNo"   column="payment_no"/>
    </resultMap>

    <sql id="selectInvoiceVo">
        select iv.invoice_id, iv.invoice_no, iv.project_id, iv.payment_id,
               iv.invoice_type, iv.invoice_status, iv.invoice_amount,
               iv.tax_rate, iv.tax_amount, iv.invoice_title, iv.tax_no,
               iv.invoice_date, iv.invoice_attachment,
               iv.del_flag, iv.create_by, iv.create_time, iv.update_by, iv.update_time, iv.remark,
               p.project_name, p.project_no,
               pm.payment_no
        from pjm_invoice iv
        left join pjm_project p on p.project_id = iv.project_id
        left join pjm_payment pm on pm.payment_id = iv.payment_id
    </sql>

    <select id="selectInvoiceList" parameterType="com.ruoyi.pjm.domain.PjmInvoice"
            resultMap="PjmInvoiceResult">
        <include refid="selectInvoiceVo"/>
        <where>
            <if test="projectId != null">AND iv.project_id = #{projectId}</if>
            <if test="invoiceNo != null and invoiceNo != ''">AND iv.invoice_no like concat('%', #{invoiceNo}, '%')</if>
            <if test="invoiceType != null and invoiceType != ''">AND iv.invoice_type = #{invoiceType}</if>
            <if test="invoiceStatus != null and invoiceStatus != ''">AND iv.invoice_status = #{invoiceStatus}</if>
            <if test="invoiceTitle != null and invoiceTitle != ''">AND iv.invoice_title like concat('%', #{invoiceTitle}, '%')</if>
            <if test="paymentId != null">AND iv.payment_id = #{paymentId}</if>
            <if test="params.beginInvoiceDate != null and params.beginInvoiceDate != ''">AND iv.invoice_date &gt;= #{params.beginInvoiceDate}</if>
            <if test="params.endInvoiceDate != null and params.endInvoiceDate != ''">AND iv.invoice_date &lt;= #{params.endInvoiceDate}</if>
            AND iv.del_flag = '0'
        </where>
        order by iv.invoice_date desc, iv.invoice_id desc
    </select>

    <select id="selectInvoiceById" parameterType="Long" resultMap="PjmInvoiceResult">
        <include refid="selectInvoiceVo"/>
        where iv.invoice_id = #{invoiceId}
    </select>

    <insert id="insertInvoice" parameterType="com.ruoyi.pjm.domain.PjmInvoice"
            useGeneratedKeys="true" keyProperty="invoiceId">
        insert into pjm_invoice
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="invoiceNo != null">invoice_no,</if>
            <if test="projectId != null">project_id,</if>
            <if test="paymentId != null">payment_id,</if>
            <if test="invoiceType != null">invoice_type,</if>
            <if test="invoiceStatus != null">invoice_status,</if>
            <if test="invoiceAmount != null">invoice_amount,</if>
            <if test="taxRate != null">tax_rate,</if>
            <if test="taxAmount != null">tax_amount,</if>
            <if test="invoiceTitle != null">invoice_title,</if>
            <if test="taxNo != null">tax_no,</if>
            <if test="invoiceDate != null">invoice_date,</if>
            <if test="invoiceAttachment != null">invoice_attachment,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="invoiceNo != null">#{invoiceNo},</if>
            <if test="projectId != null">#{projectId},</if>
            <if test="paymentId != null">#{paymentId},</if>
            <if test="invoiceType != null">#{invoiceType},</if>
            <if test="invoiceStatus != null">#{invoiceStatus},</if>
            <if test="invoiceAmount != null">#{invoiceAmount},</if>
            <if test="taxRate != null">#{taxRate},</if>
            <if test="taxAmount != null">#{taxAmount},</if>
            <if test="invoiceTitle != null">#{invoiceTitle},</if>
            <if test="taxNo != null">#{taxNo},</if>
            <if test="invoiceDate != null">#{invoiceDate},</if>
            <if test="invoiceAttachment != null">#{invoiceAttachment},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateInvoice" parameterType="com.ruoyi.pjm.domain.PjmInvoice">
        update pjm_invoice
        <set>
            <if test="projectId != null">project_id = #{projectId},</if>
            <if test="paymentId != null">payment_id = #{paymentId},</if>
            <if test="invoiceType != null">invoice_type = #{invoiceType},</if>
            <if test="invoiceStatus != null">invoice_status = #{invoiceStatus},</if>
            <if test="invoiceAmount != null">invoice_amount = #{invoiceAmount},</if>
            <if test="taxRate != null">tax_rate = #{taxRate},</if>
            <if test="taxAmount != null">tax_amount = #{taxAmount},</if>
            <if test="invoiceTitle != null">invoice_title = #{invoiceTitle},</if>
            <if test="taxNo != null">tax_no = #{taxNo},</if>
            <if test="invoiceDate != null">invoice_date = #{invoiceDate},</if>
            <if test="invoiceAttachment != null">invoice_attachment = #{invoiceAttachment},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where invoice_id = #{invoiceId}
    </update>

    <update id="deleteInvoiceByIds">
        update pjm_invoice set del_flag = '2' where invoice_id in
        <foreach item="invoiceId" collection="array" open="(" separator="," close=")">
            #{invoiceId}
        </foreach>
    </update>

    <update id="issueInvoice" parameterType="com.ruoyi.pjm.domain.PjmInvoice">
        update pjm_invoice set invoice_status = '1',
               update_by = #{updateBy},
               update_time = #{updateTime}
        where invoice_id = #{invoiceId} and invoice_status = '0'
    </update>

    <update id="voidInvoice" parameterType="com.ruoyi.pjm.domain.PjmInvoice">
        update pjm_invoice set invoice_status = '2',
               update_by = #{updateBy},
               update_time = #{updateTime}
        where invoice_id = #{invoiceId} and invoice_status = '1'
    </update>

</mapper>
