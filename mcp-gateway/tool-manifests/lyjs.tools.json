{
  "comment": "LYJS 分支工具映射（基于 standard.tools.json 扩展，接口契约见 CONTRACT.md 分支偏差登记表）。分支定制：本文件仅 LYJS 分支使用，禁止改 gateway.mjs。params 键=网关入参，值=后端查询参数名。",
  "tools": {
    "get_bi_metrics": {
      "endpoints": {
        "overview": "/bi/dashboard/overview",
        "dict": "/bi/metric/list"
      }
    },
    "query_inventory": {
      "type": "table",
      "endpoint": "/wms/inventory/list",
      "params": {
        "materialCode": "materialCode",
        "materialName": "materialName",
        "warehouseName": "warehouseName",
        "batchNo": "batchNo"
      }
    },
    "query_sales_orders": {
      "type": "table",
      "endpoint": "/mk/order/list",
      "dateRange": true,
      "params": {
        "orderNo": "orderNo",
        "customerName": "customerName",
        "orderStatus": "orderStatus",
        "startDate": "params[beginTime]",
        "endDate": "params[endTime]"
      }
    },
    "query_purchase_orders": {
      "type": "table",
      "endpoint": "/pms/order/list",
      "dateRange": true,
      "params": {
        "orderNo": "orderNo",
        "supplierName": "supplierName",
        "status": "status",
        "startDate": "params[beginTime]",
        "endDate": "params[endTime]"
      }
    },
    "get_platform_overview": {
      "type": "aggregate",
      "endpoints": {
        "bi": "/bi/dashboard/overview",
        "wms": "/wms/statistics/overview",
        "mk": "/mk/dashboard/overview",
        "pms": "/pms/dashboard/summary"
      }
    },
    "query_projects": {
      "type": "table",
      "endpoint": "/pjm/project/list",
      "params": {
        "projectNo": "projectNo",
        "projectName": "projectName",
        "status": "status"
      }
    },
    "query_safety_hazards": {
      "type": "table",
      "endpoint": "/safety/hazard/list",
      "params": {
        "hazardCode": "hazardCode",
        "hazardType": "hazardType",
        "hazardLevel": "hazardLevel",
        "hazardStatus": "hazardStatus"
      }
    },
    "query_quality_tasks": {
      "type": "table",
      "endpoint": "/qms/task/list",
      "params": {
        "taskNo": "taskNo",
        "taskType": "taskType",
        "materialName": "materialName",
        "supplierName": "supplierName",
        "batchNo": "batchNo"
      }
    },
    "query_bid_projects": {
      "type": "table",
      "endpoint": "/bid/project/list",
      "params": {
        "projectNo": "projectNo",
        "projectName": "projectName",
        "status": "status"
      }
    }
  }
}