<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mk.mapper.MkContentAuditLogMapper">

    <resultMap type="MkContentAuditLog" id="MkContentAuditLogResult">
        <result property="logId"        column="log_id"/>
        <result property="contentId"    column="content_id"/>
        <result property="auditAction"  column="audit_action"/>
        <result property="auditBy"      column="audit_by"/>
        <result property="auditTime"    column="audit_time"/>
        <result property="auditRemark"  column="audit_remark"/>
    </resultMap>

    <select id="selectAuditLogByContentId" parameterType="Long" resultMap="MkContentAuditLogResult">
        SELECT log_id, content_id, audit_action, audit_by, audit_time, audit_remark
        FROM mk_content_audit_log
        WHERE content_id = #{contentId}
        ORDER BY log_id ASC
    </select>

    <insert id="insertAuditLog" parameterType="MkContentAuditLog" useGeneratedKeys="true" keyProperty="logId">
        INSERT INTO mk_content_audit_log (content_id, audit_action, audit_by, audit_time, audit_remark)
        VALUES (#{contentId}, #{auditAction}, #{auditBy}, sysdate(), #{auditRemark})
    </insert>

</mapper>
