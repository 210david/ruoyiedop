<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ai.mapper.AiToolMapper">

    <resultMap type="AiTool" id="AiToolResult">
        <id     property="toolId"       column="tool_id"/>
        <result property="toolName"     column="tool_name"/>
        <result property="description"   column="description"/>
        <result property="paramSchema"   column="param_schema"/>
        <result property="toolType"      column="tool_type"/>
        <result property="sqlTemplate"   column="sql_template"/>
        <result property="permKey"       column="perm_key"/>
        <result property="status"        column="status"/>
        <result property="createBy"      column="create_by"/>
        <result property="createTime"    column="create_time"/>
        <result property="updateBy"      column="update_by"/>
        <result property="updateTime"    column="update_time"/>
    </resultMap>

    <sql id="selectToolVo">
        select tool_id, tool_name, description, param_schema, tool_type, sql_template, perm_key, status, create_by, create_time, update_by, update_time from ai_tool
    </sql>

    <select id="selectEnabledToolList" resultMap="AiToolResult">
        <include refid="selectToolVo"/>
        where status = '0' order by tool_id
    </select>

    <select id="selectToolByName" parameterType="String" resultMap="AiToolResult">
        <include refid="selectToolVo"/>
        where tool_name = #{toolName}
    </select>

    <select id="selectToolList" parameterType="AiTool" resultMap="AiToolResult">
        <include refid="selectToolVo"/>
        <where>
            <if test="toolName != null and toolName != ''">and tool_name like concat('%', #{toolName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by tool_id
    </select>

    <insert id="insertTool" parameterType="AiTool" useGeneratedKeys="true" keyProperty="toolId">
        insert into ai_tool (tool_name, description, param_schema, tool_type, sql_template, perm_key, status, create_by, create_time)
        values (#{toolName}, #{description}, #{paramSchema}, #{toolType}, #{sqlTemplate}, #{permKey}, #{status}, #{createBy}, sysdate())
    </insert>

    <update id="updateTool" parameterType="AiTool">
        update ai_tool
        <set>
            <if test="description != null">description = #{description},</if>
            <if test="paramSchema != null">param_schema = #{paramSchema},</if>
            <if test="toolType != null">tool_type = #{toolType},</if>
            <if test="sqlTemplate != null">sql_template = #{sqlTemplate},</if>
            <if test="permKey != null">perm_key = #{permKey},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where tool_id = #{toolId}
    </update>

    <delete id="deleteToolById" parameterType="Long">
        delete from ai_tool where tool_id = #{toolId}
    </delete>
</mapper>
