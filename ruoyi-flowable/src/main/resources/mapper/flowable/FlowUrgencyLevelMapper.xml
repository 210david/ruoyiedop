<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.flowable.mapper.FlowUrgencyLevelMapper">

    <resultMap type="FlowUrgencyLevel" id="FlowUrgencyLevelResult">
        <id     property="levelId"     column="level_id"     />
        <result property="levelValue"  column="level_value"  />
        <result property="defaultName" column="default_name" />
        <result property="customName"  column="custom_name"  />
        <result property="showOrder"   column="show_order"   />
        <result property="isSealed"    column="is_sealed"    />
        <result property="isRemind"    column="is_remind"    />
        <result property="status"      column="status"       />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
    </resultMap>

    <sql id="selectFlowUrgencyLevelVo">
        select level_id, level_value, default_name, custom_name, show_order, is_sealed, is_remind,
               status, create_by, create_time, update_by, update_time
        from flow_urgency_level
    </sql>

    <select id="selectFlowUrgencyLevelList" parameterType="FlowUrgencyLevel" resultMap="FlowUrgencyLevelResult">
        <include refid="selectFlowUrgencyLevelVo"/>
        <where>
            <if test="levelValue != null and levelValue != ''">and level_value like concat('%', #{levelValue}, '%')</if>
            <if test="defaultName != null and defaultName != ''">and default_name like concat('%', #{defaultName}, '%')</if>
            <if test="customName != null and customName != ''">and custom_name like concat('%', #{customName}, '%')</if>
            <if test="showOrder != null and showOrder != ''">and show_order = #{showOrder}</if>
            <if test="isSealed != null and isSealed != ''">and ifnull(is_sealed, '0') = #{isSealed}</if>
            <if test="isRemind != null and isRemind != ''">and ifnull(is_remind, '0') = #{isRemind}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by show_order asc, level_id asc
    </select>

    <select id="selectFlowUrgencyLevelById" parameterType="Long" resultMap="FlowUrgencyLevelResult">
        <include refid="selectFlowUrgencyLevelVo"/>
        where level_id = #{levelId}
    </select>

    <!-- 可选档位：正常状态 + 未封存，供发起页下拉使用 -->
    <select id="selectSelectableList" resultMap="FlowUrgencyLevelResult">
        <include refid="selectFlowUrgencyLevelVo"/>
        where status = '0' and ifnull(is_sealed, '0') = '0'
        order by show_order asc, level_id asc
    </select>

    <select id="selectByLevelValue" parameterType="String" resultMap="FlowUrgencyLevelResult">
        <include refid="selectFlowUrgencyLevelVo"/>
        where level_value = #{levelValue}
        limit 1
    </select>

    <insert id="insertFlowUrgencyLevel" parameterType="FlowUrgencyLevel" useGeneratedKeys="true" keyProperty="levelId">
        insert into flow_urgency_level (
            level_value, default_name, custom_name, show_order, is_sealed, is_remind, status,
            create_by, create_time
        ) values (
            #{levelValue}, #{defaultName}, #{customName}, #{showOrder}, #{isSealed}, #{isRemind}, #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateFlowUrgencyLevel" parameterType="FlowUrgencyLevel">
        update flow_urgency_level
        <set>
            <if test="defaultName != null">default_name = #{defaultName},</if>
            <if test="customName != null">custom_name = #{customName},</if>
            <if test="showOrder != null">show_order = #{showOrder},</if>
            <if test="isSealed != null">is_sealed = #{isSealed},</if>
            <if test="isRemind != null">is_remind = #{isRemind},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where level_id = #{levelId}
    </update>

    <delete id="deleteFlowUrgencyLevelById" parameterType="Long">
        delete from flow_urgency_level where level_id = #{levelId}
    </delete>

    <delete id="deleteFlowUrgencyLevelByIds" parameterType="String">
        delete from flow_urgency_level where level_id in
        <foreach item="levelId" collection="array" open="(" separator="," close=")">
            #{levelId}
        </foreach>
    </delete>

</mapper>
