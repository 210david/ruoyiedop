<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.flowable.mapper.FlowFormMapper">

    <resultMap type="FlowForm" id="FlowFormResult">
        <id     property="formId"     column="form_id"/>
        <result property="formKey"    column="form_key"/>
        <result property="formName"   column="form_name"/>
        <result property="processKey" column="process_key"/>
        <result property="fieldsJson" column="fields_json"/>
        <result property="tableName"  column="table_name"/>
        <result property="delFlag"    column="del_flag"/>
        <result property="createBy"   column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy"   column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark"     column="remark"/>
    </resultMap>

    <sql id="selectFlowFormVo">
        select form_id, form_key, form_name, process_key, fields_json, table_name, del_flag,
               create_by, create_time, update_by, update_time, remark from flow_form
    </sql>

    <select id="selectFlowFormList" parameterType="FlowForm" resultMap="FlowFormResult">
        <include refid="selectFlowFormVo"/>
        where del_flag = '0'
        <if test="formName != null and formName != ''"> AND form_name LIKE CONCAT('%', #{formName}, '%')</if>
        <if test="processKey != null and processKey != ''"> AND process_key = #{processKey}</if>
        order by form_id desc
    </select>

    <select id="selectFlowFormByFormId" parameterType="Long" resultMap="FlowFormResult">
        <include refid="selectFlowFormVo"/>
        where form_id = #{formId} and del_flag = '0'
    </select>

    <select id="selectFlowFormByFormKey" parameterType="String" resultMap="FlowFormResult">
        <include refid="selectFlowFormVo"/>
        where form_key = #{formKey} and del_flag = '0'
    </select>

    <select id="selectFlowFormByProcessKey" parameterType="String" resultMap="FlowFormResult">
        <include refid="selectFlowFormVo"/>
        where process_key = #{processKey} and del_flag = '0' limit 1
    </select>

    <insert id="insertFlowForm" parameterType="FlowForm" useGeneratedKeys="true" keyProperty="formId">
        insert into flow_form
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="formKey != null">form_key,</if>
            <if test="formName != null">form_name,</if>
            <if test="processKey != null">process_key,</if>
            <if test="fieldsJson != null">fields_json,</if>
            <if test="tableName != null">table_name,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="formKey != null">#{formKey},</if>
            <if test="formName != null">#{formName},</if>
            <if test="processKey != null">#{processKey},</if>
            <if test="fieldsJson != null">#{fieldsJson},</if>
            <if test="tableName != null">#{tableName},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateFlowForm" parameterType="FlowForm">
        update flow_form
        <trim prefix="SET" suffixOverrides=",">
            <if test="formKey != null">form_key = #{formKey},</if>
            <if test="formName != null">form_name = #{formName},</if>
            <if test="processKey != null">process_key = #{processKey},</if>
            <if test="fieldsJson != null">fields_json = #{fieldsJson},</if>
            <if test="tableName != null">table_name = #{tableName},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where form_id = #{formId}
    </update>

    <update id="deleteFlowFormByFormIds" parameterType="Long">
        update flow_form set del_flag = '2' where form_id in
        <foreach item="formId" collection="array" open="(" separator="," close=")">#{formId}</foreach>
    </update>
</mapper>
