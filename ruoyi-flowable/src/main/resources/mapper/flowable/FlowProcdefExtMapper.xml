<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.flowable.mapper.FlowProcdefExtMapper">

    <resultMap type="FlowProcdefExt" id="FlowProcdefExtResult">
        <result property="procdefId"  column="procdef_id"  />
        <result property="procKey"    column="proc_key"    />
        <result property="version"    column="version"     />
        <result property="remark"     column="remark"      />
        <result property="activeFlag" column="active_flag" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="selectFlowProcdefExtVo">
        select procdef_id, proc_key, version, remark, active_flag, create_time, update_time from flow_procdef_ext
    </sql>

    <select id="selectFlowProcdefExtByProcdefId" parameterType="String" resultMap="FlowProcdefExtResult">
        <include refid="selectFlowProcdefExtVo"/>
        where procdef_id = #{procdefId}
    </select>

    <select id="selectFlowProcdefExtByProcKey" parameterType="String" resultMap="FlowProcdefExtResult">
        <include refid="selectFlowProcdefExtVo"/>
        where proc_key = #{procKey}
    </select>

    <insert id="insertFlowProcdefExt" parameterType="FlowProcdefExt">
        insert into flow_procdef_ext
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="procdefId != null">procdef_id,</if>
            <if test="procKey != null">proc_key,</if>
            <if test="version != null">version,</if>
            <if test="remark != null">remark,</if>
            <if test="activeFlag != null">active_flag,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="procdefId != null">#{procdefId},</if>
            <if test="procKey != null">#{procKey},</if>
            <if test="version != null">#{version},</if>
            <if test="remark != null">#{remark},</if>
            <if test="activeFlag != null">#{activeFlag},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateFlowProcdefExt" parameterType="FlowProcdefExt">
        update flow_procdef_ext
        <trim prefix="SET" suffixOverrides=",">
            <if test="procKey != null">proc_key = #{procKey},</if>
            <if test="version != null">version = #{version},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="activeFlag != null">active_flag = #{activeFlag},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where procdef_id = #{procdefId}
    </update>

    <!-- 同步流程定义名称：按流程 Key 更新 act_re_procdef.NAME_
         用途：模型改名后同步已部署定义名（Flowable 7.2 RepositoryService 无重命名 API） -->
    <update id="updateDefinitionNameByKey">
        update act_re_procdef set NAME_ = #{name} where KEY_ = #{procKey} and NAME_ &lt;&gt; #{name}
    </update>

</mapper>