<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.hr.mapper.HrOutingAuditLogMapper">

    <resultMap type="HrOutingAuditLog" id="HrOutingAuditLogResult">
        <result property="logId"        column="log_id"        />
        <result property="outingId"     column="outing_id"     />
        <result property="auditAction"  column="audit_action"  />
        <result property="auditBy"      column="audit_by"      />
        <result property="auditTime"    column="audit_time"    />
        <result property="auditRemark"  column="audit_remark"  />
    </resultMap>

    <sql id="selectVo">
        select log_id, outing_id, audit_action, audit_by, audit_time, audit_remark from biz_hr_outing_audit_log
    </sql>

    <select id="selectHrOutingAuditLogByLogId" parameterType="Long" resultMap="HrOutingAuditLogResult">
        <include refid="selectVo"/> where log_id = #{logId}
    </select>

    <select id="selectHrOutingAuditLogByOutingId" parameterType="Long" resultMap="HrOutingAuditLogResult">
        <include refid="selectVo"/> where outing_id = #{outingId} order by audit_time asc, log_id asc
    </select>

    <insert id="insertHrOutingAuditLog" parameterType="HrOutingAuditLog" useGeneratedKeys="true" keyProperty="logId">
        insert into biz_hr_outing_audit_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="outingId != null">outing_id,</if>
            <if test="auditAction != null">audit_action,</if>
            <if test="auditBy != null">audit_by,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="auditRemark != null">audit_remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="outingId != null">#{outingId},</if>
            <if test="auditAction != null">#{auditAction},</if>
            <if test="auditBy != null">#{auditBy},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="auditRemark != null">#{auditRemark},</if>
        </trim>
    </insert>

    <delete id="deleteHrOutingAuditLogByLogId" parameterType="Long">
        delete from biz_hr_outing_audit_log where log_id = #{logId}
    </delete>

    <delete id="deleteHrOutingAuditLogByOutingId" parameterType="Long">
        delete from biz_hr_outing_audit_log where outing_id = #{outingId}
    </delete>

</mapper>
