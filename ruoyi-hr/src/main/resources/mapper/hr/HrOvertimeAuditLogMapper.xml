<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.hr.mapper.HrOvertimeAuditLogMapper">

    <resultMap type="HrOvertimeAuditLog" id="HrOvertimeAuditLogResult">
        <result property="logId"        column="log_id"        />
        <result property="overtimeId"   column="overtime_id"    />
        <result property="auditAction"  column="audit_action"  />
        <result property="auditBy"      column="audit_by"      />
        <result property="auditTime"    column="audit_time"    />
        <result property="auditRemark"  column="audit_remark"  />
    </resultMap>

    <sql id="selectVo">
        select log_id, overtime_id, audit_action, audit_by, audit_time, audit_remark from biz_hr_overtime_audit_log
    </sql>

    <select id="selectHrOvertimeAuditLogByLogId" parameterType="Long" resultMap="HrOvertimeAuditLogResult">
        <include refid="selectVo"/> where log_id = #{logId}
    </select>

    <select id="selectHrOvertimeAuditLogByOvertimeId" parameterType="Long" resultMap="HrOvertimeAuditLogResult">
        <include refid="selectVo"/> where overtime_id = #{overtimeId} order by audit_time asc, log_id asc
    </select>

    <insert id="insertHrOvertimeAuditLog" parameterType="HrOvertimeAuditLog" useGeneratedKeys="true" keyProperty="logId">
        insert into biz_hr_overtime_audit_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="overtimeId != null">overtime_id,</if>
            <if test="auditAction != null">audit_action,</if>
            <if test="auditBy != null">audit_by,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="auditRemark != null">audit_remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="overtimeId != null">#{overtimeId},</if>
            <if test="auditAction != null">#{auditAction},</if>
            <if test="auditBy != null">#{auditBy},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="auditRemark != null">#{auditRemark},</if>
        </trim>
    </insert>

    <delete id="deleteHrOvertimeAuditLogByLogId" parameterType="Long">
        delete from biz_hr_overtime_audit_log where log_id = #{logId}
    </delete>

    <delete id="deleteHrOvertimeAuditLogByOvertimeId" parameterType="Long">
        delete from biz_hr_overtime_audit_log where overtime_id = #{overtimeId}
    </delete>

</mapper>
